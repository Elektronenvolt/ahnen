<Window x:Class="Ahnen.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ahnen.Desktop.Localization"
        xmlns:vm="clr-namespace:Ahnen.Desktop.ViewModels"
        xmlns:views="clr-namespace:Ahnen.Desktop.Views"
        Title="{loc:Loc AppTitle}" Height="720" Width="1180" MinHeight="480" MinWidth="720">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PageViewModel}">
            <views:PageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TreePageViewModel}">
            <views:TreeView />
        </DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding SelectPageCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding SelectPageCommand}" CommandParameter="1" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Loc Language}">
                    <RadioButton Content="EN" GroupName="Language" Style="{StaticResource LanguageButton}"
                                 IsChecked="{Binding IsEnglish, Mode=OneWay}"
                                 Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                    <RadioButton Content="DE" GroupName="Language" Style="{StaticResource LanguageButton}"
                                 IsChecked="{Binding IsGerman, Mode=OneWay}"
                                 Command="{Binding SetLanguageCommand}" CommandParameter="de" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc AppTitle}" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,24,0" />
                <ListBox Style="{StaticResource NavListBox}" ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}" DisplayMemberPath="Title"
                         AutomationProperties.Name="{loc:Loc Nav_Label}" />
            </DockPanel>
        </Border>
        <views:LogsView DockPanel.Dock="Bottom" DataContext="{Binding Logs}" />
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
        <ContentControl Content="{Binding SelectedPage}" Focusable="False" />
    </DockPanel>
</Window>
