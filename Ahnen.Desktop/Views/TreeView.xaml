<UserControl x:Class="Ahnen.Desktop.Views.TreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ahnen.Desktop.Localization"
             xmlns:chart="clr-namespace:Ahnen.Desktop.Visualization">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
                <Button Content="{loc:Loc Tree_ShowAll}" Command="{Binding ShowAllCommand}" />
                <Button Content="{loc:Loc Tree_Fit}" Command="{Binding FitCommand}" />
                <Button Content="+" Command="{Binding ZoomInCommand}" AutomationProperties.Name="{loc:Loc Tree_ZoomIn}" />
                <Button Content="-" Command="{Binding ZoomOutCommand}" AutomationProperties.Name="{loc:Loc Tree_ZoomOut}" />
                <Button Content="{loc:Loc Tree_ToggleBranch}" Command="{Binding ToggleBranchCommand}" />
                <Button Content="{loc:Loc Tree_ExpandAll}" Command="{Binding ExpandAllCommand}" />
                <TextBlock Text="{Binding SceneStatus}" VerticalAlignment="Center" Margin="8,0" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>
            <Expander Header="{loc:Loc Tree_Settings}" Margin="4" IsExpanded="True">
                <WrapPanel>
                    <TextBlock Text="{loc:Loc Tree_ChartType}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding ChartChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Chart}" MinWidth="130" AutomationProperties.Name="{loc:Loc Tree_ChartType}" />
                    <TextBlock Text="{loc:Loc Tree_Depth}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding GenerationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Generations}" MinWidth="64" AutomationProperties.Name="{loc:Loc Tree_Depth}" />
                    <TextBlock Text="{loc:Loc Tree_Colors}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding ColorChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Colors}" MinWidth="125" AutomationProperties.Name="{loc:Loc Tree_Colors}" />
                    <ComboBox ItemsSource="{Binding OrientationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Orientation}" MinWidth="120" AutomationProperties.Name="{loc:Loc Tree_Orientation}" />
                    <CheckBox Content="{loc:Loc Tree_ShowIds}" IsChecked="{Binding ShowIds}" Margin="8" VerticalAlignment="Center" />
                    <CheckBox Content="{loc:Loc Tree_ShowSex}" IsChecked="{Binding ShowSex}" Margin="8" VerticalAlignment="Center" />
                </WrapPanel>
            </Expander>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Text="{Binding LayoutWarning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Loc Tree_Help}" TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="250" MinWidth="140" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Tree_FindPerson}" Margin="0,0,0,4" />
                <TextBox x:Name="Search" DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6" Margin="0,0,0,6" AutomationProperties.Name="{loc:Loc Tree_FindPerson}" KeyDown="Search_KeyDown" />
                <Button DockPanel.Dock="Bottom" Content="{loc:Loc Tree_FocusSelected}" Command="{Binding FocusSelectedCommand}" />
                <ListBox x:Name="PeopleList" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                         DisplayMemberPath="DisplayName" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="{loc:Loc Tree_AllPeople}" PreviewMouseLeftButtonUp="People_MouseUp" KeyDown="People_KeyDown" />
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <chart:TreeCanvas x:Name="Canvas" Scene="{Binding Scene}" SelectedId="{Binding SelectedPerson.Id}"
                                  FocusId="{Binding FocusId}" RootId="{Binding RootId}" Colors="{Binding Colors}"
                                  ShowIds="{Binding ShowIds}" ShowSex="{Binding ShowSex}"
                                  DataDirectory="{Binding DataDirectory}" Photos="{Binding Photos}"
                                  AutomationProperties.Name="{loc:Loc Tree_Canvas}" />
            </Border>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />
            <DockPanel Grid.Column="4" Margin="8,0,0,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding SelectedPerson.DisplayName}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Relationship}" TextWrapping="Wrap" Margin="0,6" />
                    <Button Content="{loc:Loc Tree_SetRoot}" Command="{Binding SetRootCommand}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,8" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
