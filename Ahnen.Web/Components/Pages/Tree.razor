@page "/"
@using System.Globalization
@using Ahnen.Web.Models
@using Ahnen.Web.Services
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable
@inject FamilyTreeStore Store
@inject ChartDataService ChartData
@inject RelationshipService Relationships
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@L["AppTitle"] – @L["Nav_Tree"]</PageTitle>

<div class="tree-page">
    <div class="tree-toolbar">
        <input class="tree-search" list="tree-person-list" placeholder="@L["Tree_FindPerson"]"
               @bind="_searchText" @bind:after="OnSearchSelected" />
        <datalist id="tree-person-list">
            @foreach (var p in _persons)
            {
                <option value="@PersonOption(p)"></option>
            }
        </datalist>
        <div class="tree-toolbar-spacer"></div>
        <button class="btn-icon" title="@L["Tree_ZoomIn"]" @onclick="() => ZoomAsync(1)">＋</button>
        <button class="btn-icon" title="@L["Tree_ZoomOut"]" @onclick="() => ZoomAsync(-1)">－</button>
        <button class="btn-icon" title="@L["Tree_Fit"]" @onclick="FitAsync">⤢</button>
    </div>

    @if (_persons.Count == 0)
    {
        <div class="tree-empty">
            <p>@L["Tree_Empty"]</p>
            <a class="btn btn-primary" href="/edit">@L["Nav_Edit"]</a>
        </div>
    }
    else
    {
        <div class="tree-chart-wrap @(_selected is not null ? "with-panel" : "")">
            <div id="familyChart" class="f3 tree-chart"></div>

            @if (_selected is not null)
            {
                <aside class="detail-panel">
                    <div class="detail-head">
                        @if (_selected.PhotoFile is { } photo)
                        {
                            <img class="detail-photo" src="/media/@photo" alt="" />
                        }
                        else
                        {
                            <div class="detail-photo detail-photo-placeholder @(_selected.Sex == Sex.F ? "female" : "male")">
                                @UiHelpers.Initials(_selected)
                            </div>
                        }
                        <div>
                            <h2 class="detail-name">@_selected.DisplayName</h2>
                            <div class="detail-years">@_selected.LifeYears</div>
                            @if (_rootRelation is { Length: > 0 })
                            {
                                <div class="detail-relation">
                                    @string.Format(L["Tree_RelationTo"], _rootName) <strong>@_rootRelation</strong>
                                </div>
                            }
                        </div>
                        <button class="btn-icon detail-close" title="@L["Btn_Close"]" @onclick="ClosePanel">✕</button>
                    </div>

                    <div class="detail-body">
                        @if (_selected.Birth is { } birth && (birth.Date is not null || birth.Place is not null))
                        {
                            <DetailRow Label="@L["Detail_Born"]" Value="@EventText(birth)" />
                        }
                        @if (_selected.Death is { } death && (death.Date is not null || death.Place is not null))
                        {
                            <DetailRow Label="@L["Detail_Died"]" Value="@EventText(death)" />
                        }
                        @if (_selected.Occupation is { Length: > 0 } occ)
                        {
                            <DetailRow Label="@L["Detail_Occupation"]" Value="@occ" />
                        }
                        @if (!_selected.Address.IsEmpty)
                        {
                            <DetailRow Label="@L["Detail_Address"]" Value="@_selected.Address.Summary" />
                        }
                        @foreach (var ev in _selected.Events.Where(e => e.Type is not (IndividualEventType.BIRT or IndividualEventType.DEAT or IndividualEventType.OCCU)))
                        {
                            <DetailRow Label="@(L[$"Ev_{ev.Type}"])" Value="@EventText(ev)" />
                        }
                        @if (_selected.Notes.Any(n => n.Length > 0))
                        {
                            <DetailRow Label="@L["Detail_Notes"]" Value="@string.Join(" · ", _selected.Notes.Where(n => n.Length > 0))" />
                        }

                        <RelationList Title="@L["Detail_Parents"]" People="_parents" OnSelect="SelectPerson" />
                        <RelationList Title="@L["Detail_Partners"]" People="_partners" OnSelect="SelectPerson" />
                        <RelationList Title="@L["Detail_Siblings"]" People="_siblings" OnSelect="SelectPerson" />
                        <RelationList Title="@L["Detail_Children"]" People="_children" OnSelect="SelectPerson" />
                    </div>

                    <div class="detail-actions">
                        <button class="btn" @onclick="SetAsRootAsync">@L["Tree_SetRoot"]</button>
                        <a class="btn btn-primary" href="/edit?person=@_selected.Id">@L["Tree_Edit"]</a>
                    </div>
                </aside>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "person")]
    public string? PersonQuery { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<Tree>? _selfRef;
    private IReadOnlyList<Person> _persons = [];
    private Person? _selected;
    private IReadOnlyList<Person> _parents = [], _partners = [], _children = [], _siblings = [];
    private string? _rootRelation;
    private string _rootName = "";
    private string _searchText = "";
    private bool _chartInitialized;

    protected override void OnInitialized()
    {
        _persons = Store.Persons;
        Store.Changed += OnStoreChanged;
        if (PersonQuery is { Length: > 0 })
            SelectPersonCore(PersonQuery);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _persons.Count > 0)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tree.js");
            await _module.InvokeVoidAsync("init", "familyChart", ChartData.Build(),
                _selected?.Id ?? Store.RootPersonId, _selfRef);
            _chartInitialized = true;
        }
    }

    private void OnStoreChanged() =>
        _ = InvokeAsync(async () =>
        {
            _persons = Store.Persons;
            if (_selected is not null)
                SelectPersonCore(_selected.Id);
            StateHasChanged();
            if (_chartInitialized && _module is not null)
                await _module.InvokeVoidAsync("updateData", ChartData.Build(), Store.RootPersonId);
        });

    [JSInvokable]
    public void OnPersonClicked(string personId) =>
        _ = InvokeAsync(() =>
        {
            SelectPersonCore(personId);
            StateHasChanged();
        });

    private void SelectPerson(string personId)
    {
        SelectPersonCore(personId);
        _ = _module?.InvokeVoidAsync("setMain", personId);
    }

    private void SelectPersonCore(string personId)
    {
        _selected = Store.GetPerson(personId);
        if (_selected is null) return;
        _parents = Store.ParentsOf(personId);
        _partners = Store.FamiliesAsPartner(personId)
            .SelectMany(f => f.PartnerIds).Where(id => id != personId).Distinct()
            .Select(Store.GetPerson).Where(p => p is not null).Cast<Person>().ToList();
        _children = Store.ChildrenOf(personId);
        _siblings = _parents
            .SelectMany(p => Store.ChildrenOf(p.Id))
            .Where(p => p.Id != personId)
            .DistinctBy(p => p.Id).ToList();

        var rootId = Store.RootPersonId;
        if (rootId is not null && rootId != personId)
        {
            var root = Store.GetPerson(rootId);
            _rootName = root?.DisplayName ?? "";
            var rel = Relationships.Describe(rootId, personId);
            _rootRelation = RelationshipLabeler.Label(rel, CultureInfo.CurrentUICulture);
        }
        else
        {
            _rootRelation = null;
        }
    }

    private void ClosePanel() => _selected = null;

    private async Task SetAsRootAsync()
    {
        if (_selected is null) return;
        Store.SetRootPerson(_selected.Id);
        if (_module is not null)
            await _module.InvokeVoidAsync("setMain", _selected.Id);
    }

    private async Task ZoomAsync(int dir)
    {
        if (_module is not null) await _module.InvokeVoidAsync("zoomBy", dir);
    }

    private async Task FitAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("fit");
    }

    private void OnSearchSelected()
    {
        var match = _persons.FirstOrDefault(p => PersonOption(p) == _searchText);
        if (match is null) return;
        SelectPerson(match.Id);
        _searchText = "";
    }

    private static string PersonOption(Person p) =>
        p.LifeYears is { Length: > 0 } y ? $"{p.DisplayName} ({y})" : p.DisplayName;

    private string EventText(IndividualEvent ev)
    {
        var date = GedcomDate.Display(ev.Date, CultureInfo.CurrentUICulture);
        var parts = new[] { date, ev.Place, ev.Value }.Where(s => !string.IsNullOrWhiteSpace(s));
        return string.Join(" · ", parts!);
    }

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnStoreChanged;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("destroy");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
    }
}
