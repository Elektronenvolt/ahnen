@page "/"
@using System.Globalization
@using Ahnen.Web.Helpers
@using Ahnen.Web.Models
@using Ahnen.Web.Services
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable
@inject DataStore Store
@inject ChartDataService ChartData
@inject RelationshipService Relationships
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS

<PageTitle>@L["AppTitle"] – @L["Nav_Tree"]</PageTitle>

<div class="tree-page">
    <div class="tree-toolbar">
        <div class="tree-search-wrap">
            <input class="tree-search" placeholder="@L["Tree_FindPerson"]" aria-label="@L["Tree_FindPerson"]"
                   role="combobox" aria-autocomplete="list" aria-controls="tree-person-list"
                   aria-expanded="@(_searchOpen ? "true" : "false")"
                   aria-activedescendant="@(_searchOpen && _searchIndex >= 0 ? $"tree-person-option-{_searchIndex}" : null)"
                   autocomplete="off" @bind="_searchText" @bind:event="oninput" @bind:after="FilterSearch"
                   @onfocus="FilterSearch" @onblur="CloseSearch" @onkeydown="SearchKeyDown" />
            @if (_searchOpen)
            {
                <ul id="tree-person-list" class="tree-search-results" role="listbox" aria-label="@L["Tree_FindPerson"]">
                    @for (var i = 0; i < _searchMatches.Count; i++)
                    {
                        var index = i;
                        var person = _searchMatches[index];
                        <li id="@($"tree-person-option-{index}")" role="option"
                            aria-selected="@(index == _searchIndex ? "true" : "false")"
                            class="@(index == _searchIndex ? "active" : null)"
                            @onmousedown:preventDefault @onclick="() => PickSearchPerson(person)">
                            @PersonOption(person)
                        </li>
                    }
                </ul>
                @if (_searchMatches.Count == 0)
                {
                    <div class="tree-search-no-results" role="status">@L["Tree_NoMatches"]</div>
                }
            }
        </div>
        <button class="btn" disabled="@(_persons.Count == 0)" @onclick="ResetSelectionAsync">@L["Tree_ShowAll"]</button>
        <div class="chart-types view-modes" role="group" aria-label="@L["Tree_ViewMode"]">
            <button class="chart-type @(_opts.ViewMode == "2d" ? "active" : "")"
                    @onclick='() => SetViewModeAsync("2d")'>@L["Tree_View2D"]</button>
            <button class="chart-type @(_opts.ViewMode == "3d" ? "active" : "")"
                    @onclick='() => SetViewModeAsync("3d")'>@L["Tree_View3D"]</button>
        </div>
        @if (_opts.ViewMode == "2d")
        {
            <div class="chart-types" role="group" aria-label="@L["Tree_ChartType"]">
                @foreach (var kind in ChartKinds)
                {
                    <button class="chart-type @(!_allPeople && _opts.ChartType == kind ? "active" : "")"
                            @onclick="() => SetChartTypeAsync(kind)">@L[$"Tree_Chart_{kind}"]</button>
                }
            </div>
            @if (_allPeople)
            {
                <span role="status">@L["Tree_AllPeople"]</span>
            }
        }
        <div class="tree-toolbar-spacer"></div>
        @if (_opts.ViewMode == "2d")
        {
            <div class="settings-wrap">
                <button class="btn-icon @(_settingsOpen ? "active" : "")" title="@L["Tree_Settings"]"
                        @onclick="() => _settingsOpen = !_settingsOpen">⚙</button>
                @if (_settingsOpen)
                {
                    <div class="settings-popover">
                        <label>@L["Tree_Colors"]
                            <select value="@_opts.Colors" @onchange="OnColorsChanged">
                                <option value="none">@L["Tree_Colors_none"]</option>
                                <option value="sex">@L["Tree_Colors_sex"]</option>
                                <option value="generation">@L["Tree_Colors_generation"]</option>
                            </select>
                        </label>
                        <label>@L["Tree_Orientation"]
                            <select value="@(_opts.Horizontal ? "h" : "v")" @onchange="OnOrientationChanged">
                                <option value="v">@L["Tree_Orientation_vertical"]</option>
                                <option value="h">@L["Tree_Orientation_horizontal"]</option>
                            </select>
                        </label>
                        <label>@L["Tree_Depth"]
                            <select value="@_opts.Depth" @onchange="OnDepthChanged">
                                <option value="0">@L["Tree_Depth_all"]</option>
                                @foreach (var n in new[] { 1, 2, 3, 4 })
                                {
                                    <option value="@n">@n</option>
                                }
                            </select>
                        </label>
                        <label class="check"><input type="checkbox" checked="@_opts.ShowIds"
                                                    @onchange="e => UpdateAsync(o => o.ShowIds = e.Value is true)" /> @L["Tree_ShowIds"]</label>
                        <label class="check"><input type="checkbox" checked="@_opts.ShowSex"
                                                    @onchange="e => UpdateAsync(o => o.ShowSex = e.Value is true)" /> @L["Tree_ShowSex"]</label>
                    </div>
                }
            </div>
        }
        <button class="btn-icon" title="@L["Tree_ZoomIn"]" @onclick="() => ZoomAsync(1)">＋</button>
        <button class="btn-icon" title="@L["Tree_ZoomOut"]" @onclick="() => ZoomAsync(-1)">－</button>
        <button class="btn-icon" title="@L["Tree_Fit"]" @onclick="FitAsync">⤢</button>
    </div>

    @if (_persons.Count == 0)
    {
        <div class="tree-empty">
            <p>@L[Store.CanEdit ? "Tree_Empty" : "Tree_DataUnavailable"]</p>
            <a class="btn btn-primary" href="/edit">@L["Nav_Edit"]</a>
        </div>
    }
    else
    {
        <div class="tree-chart-wrap @(_selected is not null ? "with-panel" : "")">
            <div id="familyChart" class="tree-chart" style="display: @(_opts.ViewMode == "2d" ? "block" : "none")"></div>
            <div id="familyChart3d" class="tree-chart-3d" style="display: @(_opts.ViewMode == "3d" ? "block" : "none")"></div>
            <div class="tree3d-overlays" hidden="@(_opts.ViewMode != "3d")">
                <div id="familyChart3dStatus" class="tree3d-status" role="status" hidden></div>
                <div id="familyChart3dTooltip" class="tree3d-tooltip" role="tooltip" hidden></div>
                <div id="familyChart3dSummary" class="tree3d-summary" aria-live="polite" hidden></div>
                <aside class="tree3d-legend" aria-label="@L["Tree_3dLegend"]">
                    <strong>@L["Tree_3dLegend"]</strong>
                    <div>@L["Tree_3dLegendLevels"]</div>
                    <div>@L["Tree_3dLegendColors"]</div>
                    <div>@L["Tree_3dLegendLinks"]</div>
                    <div>@L["Tree_3dLegendFocus"]</div>
                </aside>
            </div>

            @if (_selected is not null)
            {
                <aside class="detail-panel">
                    <div class="detail-head">
                        @if (_selected.PhotoFile is { } photo)
                        {
                            <img class="detail-photo" src="/media/@photo" alt="" />
                        }
                        else
                        {
                            <div class="detail-photo detail-photo-placeholder @(_selected.Sex == Sex.F ? "female" : "male")">
                                @UiHelpers.Initials(_selected)
                            </div>
                        }
                        <div>
                            <h2 class="detail-name">@_selected.DisplayName</h2>
                            <div class="detail-years">@_selected.LifeYears</div>
                            @if (_rootRelation is { Length: > 0 })
                            {
                                <div class="detail-relation">
                                    @string.Format(L["Tree_RelationTo"], _rootName) <strong>@_rootRelation</strong>
                                </div>
                            }
                        </div>
                        <button class="btn-icon detail-close" title="@L["Btn_Close"]" @onclick="ClosePanel">✕</button>
                    </div>

                    <div class="detail-body">
                        @if (_selected.Birth is { } birth && (birth.Date is not null || birth.Place is not null))
                        {
                            <DetailRow Label="@L["Detail_Born"]" Value="@EventText(birth)" />
                        }
                        @if (_selected.Death is { } death && (death.Date is not null || death.Place is not null))
                        {
                            <DetailRow Label="@L["Detail_Died"]" Value="@EventText(death)" />
                        }
                        @if (_selected.Occupation is { Length: > 0 } occ)
                        {
                            <DetailRow Label="@L["Detail_Occupation"]" Value="@occ" />
                        }
                        @if (!_selected.Address.IsEmpty)
                        {
                            <DetailRow Label="@L["Detail_Address"]" Value="@_selected.Address.Summary" />
                        }
                        @foreach (var ev in _selected.Events.Where(e => e.Type is not (IndividualEventType.BIRT or IndividualEventType.DEAT or IndividualEventType.OCCU)))
                        {
                            <DetailRow Label="@(L[$"Ev_{ev.Type}"])" Value="@EventText(ev)" />
                        }
                        @if (_selected.Notes.Any(n => n.Length > 0))
                        {
                            <DetailRow Label="@L["Detail_Notes"]" Value="@string.Join(" · ", _selected.Notes.Where(n => n.Length > 0))" />
                        }

                        <RelationList Title="@L["Detail_Parents"]" People="_parents" OnSelect="SelectPerson" />
                        <RelationList Title="@L["Detail_Partners"]" People="_partners" OnSelect="SelectPerson" />
                        <RelationList Title="@L["Detail_Siblings"]" People="_siblings" OnSelect="SelectPerson" />
                        <RelationList Title="@L["Detail_Children"]" People="_children" OnSelect="SelectPerson" />
                    </div>

                    <div class="detail-actions">
                        <button class="btn" disabled="@(!Store.CanEdit)" @onclick="SetAsRootAsync">@L["Tree_SetRoot"]</button>
                        <a class="btn btn-primary" href="/edit?person=@_selected.Id">@L["Tree_Edit"]</a>
                    </div>
                </aside>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "person")]
    public string? PersonQuery { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<Tree>? _selfRef;
    private IReadOnlyList<Person> _persons = [];
    private Person? _selected;
    private IReadOnlyList<Person> _parents = [], _partners = [], _children = [], _siblings = [];
    private string? _rootRelation;
    private string _rootName = "";
    private string _searchText = "";
    private bool _searchOpen;
    private int _searchIndex = -1;
    private bool _scrollSearch;
    private List<Person> _searchMatches = [];
    private bool _chartInitialized;
    private bool _settingsOpen;
    private bool _allPeople;
    private ChartOptions _opts = new();
    private string? _pendingViewMode;

    private static readonly string[] ChartKinds = ["hourglass", "relatives", "ancestors", "descendants"];

    /// <summary>Display options of the chart; persisted client-side (localStorage) by the JS module.</summary>
    public class ChartOptions
    {
        public string ChartType { get; set; } = "hourglass";
        public string Colors { get; set; } = "sex";
        public bool Horizontal { get; set; }
        public bool ShowIds { get; set; }
        public bool ShowSex { get; set; } = true;
        public int Depth { get; set; }
        public string ViewMode { get; set; } = "2d";
    }

    protected override void OnInitialized()
    {
        _persons = Store.Persons;
        Store.Changed += OnStoreChanged;
        if (PersonQuery is { Length: > 0 })
            SelectPersonCore(PersonQuery);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollSearch && _module is not null)
        {
            _scrollSearch = false;
            await _module.InvokeVoidAsync("scrollSearchOption", $"tree-person-option-{_searchIndex}");
        }

        if (!_chartInitialized && _persons.Count > 0)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/tree.js");
            _opts = await _module.InvokeAsync<ChartOptions>("init", "familyChart", ChartData.Build(),
                _selected?.Id ?? Store.RootPersonId, _selfRef, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
            _chartInitialized = true;
            if (_opts.ViewMode == "3d")
                _pendingViewMode = "3d";
            StateHasChanged();
        }
        else if (_pendingViewMode is { } mode && _module is not null)
        {
            _pendingViewMode = null;
            if (mode == "3d")
                await Init3dAsync();
            else
            {
                await _module.InvokeVoidAsync("destroy3d");
                await _module.InvokeVoidAsync("refresh2d");
            }
        }
    }

    private void OnStoreChanged() =>
        _ = InvokeAsync(async () =>
        {
            _persons = Store.Persons;
            if (_searchOpen) FilterSearch();
            if (_selected is not null)
                SelectPersonCore(_selected.Id);
            StateHasChanged();
            if (_chartInitialized && _module is not null)
            {
                if (_persons.Count == 0)
                {
                    await _module.InvokeVoidAsync("destroy");
                    _chartInitialized = false;
                }
                else
                {
                    var data = ChartData.Build();
                    await _module.InvokeVoidAsync("updateData", data, Store.RootPersonId);
                    if (_opts.ViewMode == "3d")
                        await _module.InvokeVoidAsync("update3d", data, Store.RootPersonId);
                }
            }
        });

    [JSInvokable]
    public Task OnPersonClicked(string personId, bool refocus) =>
        InvokeAsync(async () =>
        {
            _settingsOpen = false;
            SelectPersonCore(personId);
            if (refocus)
            {
                _allPeople = false;
                if (_module is not null)
                    await _module.InvokeVoidAsync("setMain", personId);
            }
            StateHasChanged();
        });

    private void SelectPerson(string personId)
    {
        _allPeople = false;
        SelectPersonCore(personId);
        _ = _module?.InvokeVoidAsync("setMain", personId);
    }

    private void SelectPersonCore(string personId)
    {
        _selected = Store.GetPerson(personId);
        if (_selected is null) return;
        _parents = Store.ParentsOf(personId);
        _partners = Store.PartnersOf(personId);
        _children = Store.ChildrenOf(personId);
        _siblings = _parents
            .SelectMany(p => Store.ChildrenOf(p.Id))
            .Where(p => p.Id != personId)
            .DistinctBy(p => p.Id).ToList();

        var rootId = Store.RootPersonId;
        if (rootId is not null && rootId != personId)
        {
            var root = Store.GetPerson(rootId);
            _rootName = root?.DisplayName ?? "";
            var rel = Relationships.Describe(rootId, personId);
            _rootRelation = RelationshipLabeler.Label(rel, CultureInfo.CurrentUICulture);
        }
        else
        {
            _rootRelation = null;
        }
    }

    private async Task ClosePanel()
    {
        _selected = null;
        if (_module is not null && _opts.ViewMode == "3d")
            await _module.InvokeVoidAsync("clearSelection3d");
    }

    private async Task ResetSelectionAsync()
    {
        _selected = null;
        _searchText = "";
        CloseSearch();
        _settingsOpen = false;
        _allPeople = true;
        if (_module is not null)
            await _module.InvokeVoidAsync("resetSelection", Store.RootPersonId);
    }

    private async Task SetAsRootAsync()
    {
        Store.EnsureCanEdit();
        if (_selected is null) return;
        _allPeople = false;
        Store.SetRootPerson(_selected.Id);
        if (_module is not null)
            await _module.InvokeVoidAsync("setMain", _selected.Id);
    }

    private async Task SetChartTypeAsync(string kind)
    {
        _allPeople = false;
        if (_module is not null)
            await _module.InvokeVoidAsync("setMain", _selected?.Id ?? Store.RootPersonId ?? _persons.FirstOrDefault()?.Id);
        await UpdateAsync(o => o.ChartType = kind);
    }

    private async Task SetViewModeAsync(string mode)
    {
        if (mode is not ("2d" or "3d") || _opts.ViewMode == mode)
            return;
        _opts.ViewMode = mode;
        _settingsOpen = false;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setViewMode", mode);
            _pendingViewMode = mode;
        }
    }

    private async Task Init3dAsync()
    {
        if (_module is null || _selfRef is null)
            return;
        await _module.InvokeVoidAsync("init3d", new
        {
            containerId = "familyChart3d",
            statusId = "familyChart3dStatus",
            tooltipId = "familyChart3dTooltip",
            summaryId = "familyChart3dSummary",
            data = ChartData.Build(),
            rootId = Store.RootPersonId,
            selectedId = _selected?.Id,
            callback = _selfRef,
            locale = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
            labels = new
            {
                unavailable = L["Tree_3dUnavailable"].Value,
                canvas = L["Tree_3dCanvasLabel"].Value,
                person = L["Tree_3dFigureLabel"].Value,
                root = L["Tree_3dRoot"].Value,
                rootGeneration = L["Tree_3dRootGeneration"].Value,
                above = L["Tree_3dAbove"].Value,
                below = L["Tree_3dBelow"].Value,
                separate = L["Tree_3dSeparate"].Value,
                cycle = L["Tree_3dCycle"].Value,
                conflictingLevels = L["Tree_3dConflictingLevels"].Value,
                selected = L["Tree_3dSelected"].Value,
                preview = L["Tree_3dPreview"].Value,
                parent = L["Detail_Parents"].Value,
                partner = L["Detail_Partners"].Value,
                child = L["Detail_Children"].Value,
                self = L["Tree_3dSelf"].Value,
                noRelations = L["Tree_3dNoRelations"].Value
            }
        });
    }

    private Task OnColorsChanged(ChangeEventArgs e) => UpdateAsync(o => o.Colors = e.Value?.ToString() ?? "sex");

    private Task OnOrientationChanged(ChangeEventArgs e) => UpdateAsync(o => o.Horizontal = e.Value?.ToString() == "h");

    private Task OnDepthChanged(ChangeEventArgs e) =>
        UpdateAsync(o => o.Depth = int.TryParse(e.Value?.ToString(), out var depth) ? depth : 0);

    private async Task UpdateAsync(Action<ChartOptions> change)
    {
        change(_opts);
        if (_module is not null)
            _opts = await _module.InvokeAsync<ChartOptions>("setOptions", _opts);
    }

    private async Task ZoomAsync(int dir)
    {
        if (_module is not null) await _module.InvokeVoidAsync("zoomBy", dir, _opts.ViewMode);
    }

    private async Task FitAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync(_opts.ViewMode == "3d" ? "fit3d" : "fit");
    }

    private void FilterSearch()
    {
        _searchMatches = _persons.Where(p => PersonOption(p).Contains(_searchText, StringComparison.CurrentCultureIgnoreCase)).ToList();
        _searchIndex = -1;
        _searchOpen = true;
    }

    private void CloseSearch()
    {
        _searchOpen = false;
        _searchIndex = -1;
        _scrollSearch = false;
    }

    private void PickSearchPerson(Person person)
    {
        SelectPerson(person.Id);
        _searchText = "";
        CloseSearch();
    }

    private void SearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseSearch();
            return;
        }
        if (e.Key == "Enter")
        {
            if (_searchOpen && _searchIndex >= 0 && _searchIndex < _searchMatches.Count)
                PickSearchPerson(_searchMatches[_searchIndex]);
            else if (_persons.FirstOrDefault(p => PersonOption(p) == _searchText) is { } match)
                PickSearchPerson(match);
            return;
        }
        if (e.Key is not ("ArrowDown" or "ArrowUp")) return;
        if (!_searchOpen) FilterSearch();
        if (_searchMatches.Count == 0) return;
        _searchIndex = e.Key == "ArrowDown"
            ? (_searchIndex + 1) % _searchMatches.Count
            : (_searchIndex <= 0 ? _searchMatches.Count : _searchIndex) - 1;
        _scrollSearch = true;
    }

    private static string PersonOption(Person p) =>
        p.LifeYears is { Length: > 0 } y ? $"{p.DisplayName} ({y})" : p.DisplayName;

    private string EventText(IndividualEvent ev)
    {
        var date = GedcomDate.Display(ev.Date, CultureInfo.CurrentUICulture);
        return new[] { date, ev.Place, ev.Value }.JoinNonBlank(" · ");
    }

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnStoreChanged;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("destroy");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
    }
}
